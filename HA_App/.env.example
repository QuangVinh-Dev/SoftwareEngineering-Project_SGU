# Copy thành .env (không commit file .env), sau đó tự điền các secret.
# Có thể tạo giá trị ngẫu nhiên bằng: openssl rand -hex 32
POSTGRES_DB=hoian_db
POSTGRES_USER=hoian
POSTGRES_PASSWORD=
REDIS_PASSWORD=

JWT_SECRET=
JWT_ISSUER=hoian-api
JWT_EXPIRATION_MINUTES=60

APP_ADMIN_PASSWORD=
APP_SUPER_ADMIN_PASSWORD=
APP_SEED_MERCHANT_PASSWORD=

# Chỉ cấu hình IP/CIDR peer của reverse proxy tin cậy; để trống nếu truy cập trực tiếp.
APP_PROXY_TRUSTED_PROXIES=

# UID/GID cần khớp user sở hữu Data_Storage trên host để app non-root ghi audio/ảnh.
APP_UID=1000
APP_GID=1000

# Origin của các FE (HA.USER / HA_ADMIN / HA_Store Owner), cách nhau bằng dấu phẩy
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# VNPAY Sandbox: lấy credentials từ tài khoản sandbox; không commit giá trị thật.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=
VNPAY_IPN_URL=
